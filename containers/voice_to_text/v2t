#!/bin/bash
# ==============================================================================
# v2t - Universal Voice Typing & Container Control CLI for Linux Host
# ==============================================================================

PID_FILE="/tmp/v2t_recording.pid"
CONFIG_FILE="${HOME}/.config/v2t.conf"

mkdir -p "${HOME}/.config"

if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
fi

ACTIVE_ENGINE=${ACTIVE_ENGINE:-"openwhispr"} # openwhispr (8090), handy (8091), whispercpp (8092)

get_port() {
    case $1 in
        openwhispr) echo 8090 ;;
        handy)      echo 8091 ;;
        whispercpp) echo 8092 ;;
        *)          echo 8090 ;;
    esac
}

get_endpoint() {
    local engine=$1
    local port=$(get_port "$engine")
    case $engine in
        openwhispr) echo "http://localhost:${port}/v1/audio/transcriptions" ;;
        handy)      echo "http://localhost:${port}/v1/audio/transcriptions" ;;
        whispercpp) echo "http://localhost:${port}/inference" ;;
    esac
}

send_notify() {
    local title=$1
    local msg=$2
    if command -v notify-send &> /dev/null; then
        notify-send -h string:x-canonical-private-synchronous:v2t -t 2000 "$title" "$msg"
    fi
}

inject_text() {
    local text=$1
    if [ -z "$text" ]; then return; fi

    if command -v ydotool &> /dev/null; then
        ydotool type "$text"
    elif command -v xdotool &> /dev/null; then
        xdotool type --clearmodifiers "$text"
    elif command -v wtype &> /dev/null; then
        wtype "$text"
    else
        echo "$text" | xclip -selection clipboard 2>/dev/null || true
        send_notify "v2t Voice Typing" "Text copied to clipboard: $text"
    fi
}

ensure_container_running() {
    local engine=$1
    local port=$(get_port "$engine")
    if ! curl -s "http://localhost:${port}/health" &>/dev/null; then
        send_notify "🚀 Starting Container" "Launching ${engine} container..."
        local script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
        local project_dir="/home/krikan/productivity/deeplens/containers/voice_to_text"
        if [ -d "$project_dir" ]; then
            (cd "$project_dir" && docker compose up -d "$engine")
        fi
        sleep 2
    fi
}

cmd_type() {
    if [ -f "$PID_FILE" ]; then
        cmd_stop
        exit 0
    fi

    ensure_container_running "$ACTIVE_ENGINE"

    local duration=${1:-5}
    local tmp_wav=$(mktemp /tmp/v2t_voice_XXXXXX.wav)

    send_notify "🎙️ Voice Typing..." "Speak now (Engine: ${ACTIVE_ENGINE})"

    if command -v ffmpeg &> /dev/null; then
        ffmpeg -y -f pulse -i default -t "$duration" -ac 1 -ar 16000 "$tmp_wav" -loglevel quiet &
        REC_PID=$!
    elif command -v arecord &> /dev/null; then
        arecord -d "$duration" -r 16000 -f S16_LE -c 1 "$tmp_wav" &
        REC_PID=$!
    else
        send_notify "❌ Error" "Neither ffmpeg nor arecord found"
        exit 1
    fi

    echo "$REC_PID $tmp_wav" > "$PID_FILE"
    wait $REC_PID 2>/dev/null
    rm -f "$PID_FILE"

    local endpoint=$(get_endpoint "$ACTIVE_ENGINE")
    send_notify "⚙️ Transcribing..." "Processing with ${ACTIVE_ENGINE}"

    local response=$(curl -s -F "file=@${tmp_wav}" "$endpoint")
    rm -f "$tmp_wav"

    local text=""
    if command -v jq &> /dev/null; then
        text=$(echo "$response" | jq -r '.text // .transcription[0].text // empty')
    else
        text=$(echo "$response" | grep -o '"text":"[^"]*"' | cut -d'"' -f4)
    fi

    if [ -n "$text" ]; then
        send_notify "✅ Typed!" "\"$text\""
        inject_text "$text"
    else
        send_notify "⚠️ Warning" "No speech recognized or service error"
    fi
}

cmd_stop() {
    if [ -f "$PID_FILE" ]; then
        read rec_pid tmp_wav < "$PID_FILE"
        kill "$rec_pid" 2>/dev/null || true
        rm -f "$PID_FILE"
    fi
}

cmd_stop_containers() {
    send_notify "🧹 Memory Cleanup" "Stopping voice-to-text containers to free VRAM/RAM..."
    local project_dir="/home/krikan/productivity/deeplens/containers/voice_to_text"
    if [ -d "$project_dir" ]; then
        (cd "$project_dir" && docker compose stop)
    fi
    echo "All voice-to-text containers stopped. VRAM and System RAM released."
}

cmd_switch() {
    local target=$1
    if [[ ! "$target" =~ ^(openwhispr|handy|whispercpp)$ ]]; then
        echo "Usage: v2t switch <openwhispr|handy|whispercpp>"
        exit 1
    fi
    echo "ACTIVE_ENGINE=$target" > "$CONFIG_FILE"
    send_notify "v2t Engine Switched" "Active engine set to: $target"
    echo "Active voice typing engine set to: $target"
}

cmd_status() {
    echo "=========================================="
    echo "  v2t - Voice Typing & RAM/VRAM Status"
    echo "=========================================="
    echo "Active Engine: ${ACTIVE_ENGINE}"
    echo "Endpoint:      $(get_endpoint "$ACTIVE_ENGINE")"
    echo "Port:          $(get_port "$ACTIVE_ENGINE")"
    echo "------------------------------------------"
    echo "Container Health Checks & Memory Footprint:"
    if curl -s http://localhost:8090/health &>/dev/null; then
        echo "  [OpenWhispr 8090]:  RUNNING (~500MB VRAM/RAM)"
    else
        echo "  [OpenWhispr 8090]:  STOPPED (0MB RAM)"
    fi

    if curl -s http://localhost:8091/health &>/dev/null; then
        echo "  [Handy 8091]:       RUNNING (~1.3GB VRAM/RAM)"
    else
        echo "  [Handy 8091]:       STOPPED (0MB RAM)"
    fi

    if curl -s http://localhost:8092/health &>/dev/null; then
        echo "  [whisper.cpp 8092]: RUNNING (~200MB VRAM/RAM)"
    else
        echo "  [whisper.cpp 8092]: STOPPED (0MB RAM)"
    fi
    echo "=========================================="
}

case $1 in
    type|start)          cmd_type ${2:-5} ;;
    stop)                cmd_stop ;;
    pause|stop-container|free) cmd_stop_containers ;;
    switch)              cmd_switch "$2" ;;
    status)              cmd_status ;;
    *)
        echo "Usage: v2t [type|stop|pause|switch <engine>|status]"
        echo "Example: v2t type 5                  (Voice type 5 seconds)"
        echo "Example: v2t pause                   (Stop containers & free VRAM/RAM)"
        echo "Example: v2t switch whispercpp       (Switch active engine)"
        echo "Example: v2t status                  (Check RAM/VRAM & container status)"
        ;;
esac

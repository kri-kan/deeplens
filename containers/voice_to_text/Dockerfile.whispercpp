# Stage 1: Build whisper.cpp with Vulkan support
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    curl \
    ca-certificates \
    xz-utils \
    libvulkan-dev \
    vulkan-tools \
    spirv-headers \
    spirv-tools \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# Install official LunarG Vulkan SDK glslc shader compiler
RUN curl -sSL "https://sdk.lunarg.com/sdk/download/1.3.296.0/linux/vulkansdk-linux-x86_64-1.3.296.0.tar.xz" -o /tmp/vulkansdk.tar.xz \
    && tar -xf /tmp/vulkansdk.tar.xz -C /tmp \
    && cp /tmp/1.3.296.0/x86_64/bin/glslc /usr/local/bin/glslc \
    && chmod +x /usr/local/bin/glslc \
    && rm -rf /tmp/vulkansdk* /tmp/1.3.296.0

WORKDIR /build

# Clone whisper.cpp v1.8.4 branch/tag with submodules
RUN git clone --recurse-submodules --branch master --depth 1 https://github.com/ggerganov/whisper.cpp.git .

# Configure and build with Vulkan acceleration enabled
RUN cmake -B build \
    -DGGML_VULKAN=ON \
    -DBUILD_SHARED_LIBS=OFF \
    -DWHISPER_BUILD_SERVER=ON \
    -DWHISPER_BUILD_EXAMPLES=ON

RUN cmake --build build --config Release -j$(nproc)

# Stage 2: Minimal Runtime image
FROM ubuntu:22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    libvulkan1 \
    vulkan-tools \
    mesa-vulkan-drivers \
    ca-certificates \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binaries and model download script from builder
COPY --from=builder /build/build/bin/whisper-server /app/whisper-server
COPY --from=builder /build/build/bin/whisper-cli /app/whisper-cli
COPY --from=builder /build/models/download-ggml-model.sh /app/download-ggml-model.sh

RUN chmod +x /app/download-ggml-model.sh /app/whisper-server

RUN mkdir -p /models/whispercpp

# Entrypoint script to check/download quantized model and start server
COPY <<'EOF' /app/entrypoint.sh
#!/bin/bash
set -e

MODEL_NAME=${WHISPER_MODEL:-"base"}
MODEL_FILE="/models/whispercpp/ggml-${MODEL_NAME}.bin"

if [ ! -f "$MODEL_FILE" ]; then
    echo "Model file $MODEL_FILE not found. Downloading model '$MODEL_NAME'..."
    /app/download-ggml-model.sh "$MODEL_NAME" /models/whispercpp
fi

echo "Starting whisper.cpp server with Vulkan acceleration on port 8092..."
exec /app/whisper-server \
    -m "$MODEL_FILE" \
    --port 8092 \
    --host 0.0.0.0 \
    --inference-device 0
EOF

RUN chmod +x /app/entrypoint.sh

EXPOSE 8092

ENV WHISPER_MODEL=small
ENV MODEL_CACHE_DIR=/models/whispercpp

ENTRYPOINT ["/app/entrypoint.sh"]

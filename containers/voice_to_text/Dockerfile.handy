FROM python:3.10-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    git \
    libvulkan1 \
    vulkan-tools \
    mesa-vulkan-drivers \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies for Handy container (ONNX Runtime, HuggingFace Transformers, PyTorch, FastAPI / Uvicorn)
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    python-multipart \
    onnxruntime \
    transformers \
    soundfile \
    numpy

RUN mkdir -p /app /models/handy

# Create Handy server script supporting Parakeet / ONNX / Whisper pipeline
COPY <<'EOF' /app/server.py
import os
import tempfile
import soundfile as sf
from fastapi import FastAPI, UploadFile, File, HTTPException
from fastapi.responses import JSONResponse
from transformers import pipeline

app = FastAPI(title="Handy Voice-to-Text Server", description="Parakeet / Whisper 4GB VRAM Optimized Container")

MODEL_ID = os.environ.get("HANDY_MODEL", "openai/whisper-tiny")
MODEL_CACHE = os.environ.get("MODEL_CACHE_DIR", "/models/handy")

print(f"Loading Handy Model: {MODEL_ID} into cache {MODEL_CACHE}...")
try:
    asr_pipeline = pipeline(
        "automatic-speech-recognition",
        model=MODEL_ID,
        model_kwargs={"cache_dir": MODEL_CACHE},
        chunk_length_s=30,
        stride_length_s=5
    )
    print("Handy Model initialized successfully!")
except Exception as e:
    print(f"Error loading pipeline: {e}")
    asr_pipeline = None

@app.get("/health")
def health():
    return {"status": "ok" if asr_pipeline else "loading_error", "model": MODEL_ID}

@app.post("/v1/audio/transcriptions")
async def transcribe(file: UploadFile = File(...)):
    if not asr_pipeline:
        raise HTTPException(status_code=500, detail="ASR Pipeline not initialized")
    
    with tempfile.NamedTemporaryFile(delete=False, suffix=".wav") as tmp:
        content = await file.read()
        tmp.write(content)
        tmp_path = tmp.name

    try:
        result = asr_pipeline(tmp_path)
        os.remove(tmp_path)
        return {"text": result["text"]}
    except Exception as e:
        if os.path.exists(tmp_path):
            os.remove(tmp_path)
        raise HTTPException(status_code=500, detail=str(e))

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8091)
EOF

EXPOSE 8091

ENV HANDY_MODEL=openai/whisper-small
ENV MODEL_CACHE_DIR=/models/handy

CMD ["python", "/app/server.py"]

FROM python:3.10-slim

# Install system dependencies including Vulkan, FFmpeg, and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    git \
    libvulkan1 \
    vulkan-tools \
    mesa-vulkan-drivers \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies for OpenWhispr (Faster-Whisper / CTranslate2, Flask, PyTorch with Vulkan/CPU/CUDA support)
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir \
    faster-whisper \
    flask \
    flask-cors \
    requests \
    numpy

# Create app directory & models directory
RUN mkdir -p /app/static /models/openwhispr

# Create OpenWhispr Control Panel Server script
COPY <<'EOF' /app/server.py
import os
import tempfile
from flask import Flask, request, jsonify, render_template_string
from flask_cors import CORS
from faster_whisper import WhisperModel

app = Flask(__name__)
CORS(app)

MODEL_SIZE = os.environ.get("WHISPER_MODEL", "base")
DEVICE = os.environ.get("WHISPER_DEVICE", "auto")
COMPUTE_TYPE = os.environ.get("WHISPER_COMPUTE_TYPE", "int8")
CACHE_DIR = os.environ.get("MODEL_CACHE_DIR", "/models/openwhispr")

print(f"Loading OpenWhispr Model: {MODEL_SIZE} on {DEVICE} ({COMPUTE_TYPE})...")
model = WhisperModel(MODEL_SIZE, device=DEVICE, compute_type=COMPUTE_TYPE, download_root=CACHE_DIR)
print("Model loaded successfully!")

HTML_TEMPLATE = """
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>OpenWhispr Control Panel</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #0f172a; color: #f8fafc; margin: 0; padding: 2rem; }
        .container { max-width: 800px; margin: auto; background: #1e293b; padding: 2rem; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); }
        h1 { color: #38bdf8; margin-top: 0; }
        .badge { background: #3b82f6; color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.85rem; }
        .status { margin-bottom: 1.5rem; padding: 1rem; background: #334155; border-radius: 8px; }
        input[type="file"], button { margin: 10px 0; padding: 10px 16px; border-radius: 6px; border: none; font-size: 1rem; }
        button { background: #10b981; color: white; cursor: pointer; transition: 0.2s; }
        button:hover { background: #059669; }
        #result { margin-top: 1.5rem; padding: 1rem; background: #0f172a; border-radius: 8px; white-space: pre-wrap; font-family: monospace; border: 1px solid #475569; }
    </style>
</head>
<body>
    <div class="container">
        <h1>🎙️ OpenWhispr Control Panel</h1>
        <div class="status">
            <p><strong>Active Model:</strong> <span class="badge">{{ model_size }}</span></p>
            <p><strong>Device / Compute:</strong> {{ device }} / {{ compute_type }}</p>
            <p><strong>Status:</strong> Ready (VRAM Optimized for 4GB)</p>
        </div>

        <h3>Transcribe Audio File</h3>
        <input type="file" id="audioFile" accept="audio/*">
        <br>
        <button onclick="uploadAndTranscribe()">Transcribe</button>

        <h3>Output Text</h3>
        <div id="result">Select an audio file and click Transcribe...</div>
    </div>

    <script>
        async function uploadAndTranscribe() {
            const fileInput = document.getElementById('audioFile');
            const resultDiv = document.getElementById('result');
            if (!fileInput.files.length) {
                alert('Please select an audio file first!');
                return;
            }
            resultDiv.innerText = 'Transcribing... Please wait...';
            const formData = new FormData();
            formData.append('file', fileInput.files[0]);

            try {
                const response = await fetch('/v1/audio/transcriptions', { method: 'POST', body: formData });
                const data = await response.json();
                resultDiv.innerText = data.text || JSON.stringify(data, null, 2);
            } catch (err) {
                resultDiv.innerText = 'Error during transcription: ' + err;
            }
        }
    </script>
</body>
</html>
"""

@app.route('/', methods=['GET'])
def index():
    return render_template_string(HTML_TEMPLATE, model_size=MODEL_SIZE, device=DEVICE, compute_type=COMPUTE_TYPE)

@app.route('/health', methods=['GET'])
def health():
    return jsonify({"status": "ok", "model": MODEL_SIZE, "device": DEVICE})

@app.route('/v1/audio/transcriptions', methods=['POST'])
def transcribe():
    if 'file' not in request.files:
        return jsonify({"error": "No file provided"}), 400
    
    audio_file = request.files['file']
    with tempfile.NamedTemporaryFile(delete=False, suffix=".wav") as tmp:
        audio_file.save(tmp.name)
        tmp_path = tmp.name

    try:
        segments, info = model.transcribe(tmp_path, beam_size=2)
        text = " ".join([segment.text for segment in segments]).strip()
        os.remove(tmp_path)
        return jsonify({
            "text": text,
            "language": info.language,
            "duration": info.duration
        })
    except Exception as e:
        if os.path.exists(tmp_path):
            os.remove(tmp_path)
        return jsonify({"error": str(e)}), 500

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=8090)
EOF

EXPOSE 8090

ENV WHISPER_MODEL=small
ENV WHISPER_DEVICE=auto
ENV WHISPER_COMPUTE_TYPE=int8
ENV MODEL_CACHE_DIR=/models/openwhispr

CMD ["python", "/app/server.py"]

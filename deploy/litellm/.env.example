# =============================================================================
# DeepLens LiteLLM Gateway Environment Variables
# =============================================================================

# Gemini API Keys for Multi-Key Load Balancing (least-busy routing pool)
GEMINI_API_KEY_1=AIzaSyPlaceholderKey1ForGeminiFlash25
GEMINI_API_KEY_2=AIzaSyPlaceholderKey2ForGeminiFlash25
GEMINI_API_KEY_3=AIzaSyPlaceholderKey3ForGeminiFlash25

# LiteLLM Master API Key (Bearer Token for client authentication)
LITELLM_MASTER_KEY=sk-deeplens-master-key

# Gateway Port
LITELLM_PORT=4000

# Local Ollama Backend Base URL (inside docker network: http://ollama-gpu:11434)
OLLAMA_API_BASE=http://ollama-gpu:11434

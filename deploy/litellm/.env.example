# =============================================================================
# DeepLens LiteLLM Gateway Environment Variables
# =============================================================================

# LiteLLM Master API Key (Bearer Token for client authentication)
LITELLM_MASTER_KEY=sk-deeplens-master-key

# Gateway Port
LITELLM_PORT=4000

# Local Ollama Backend Base URL (inside docker network: http://ollama-gpu:11434)
OLLAMA_API_BASE=http://ollama-gpu:11434

# PostgreSQL Database Connection for Admin UI & Spend Tracking
DATABASE_URL=postgresql://postgres:postgres@192.168.0.170:5432/litellm
STORE_MODEL_IN_DB=True

# LiteLLM Admin UI Credentials
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=sk-deeplens-master-key

# Redis Cache & Router State Configuration
REDIS_HOST=192.168.0.170
REDIS_PORT=6379
REDIS_URL=redis://192.168.0.170:6379/0
